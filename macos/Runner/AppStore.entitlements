<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store / TestFlight. Not used by Xcode: scripts/store_build.sh
	     macos-release builds unsigned, the .app is then signed with this file
	     (docs/release/shorebird.md). keychain-access-groups and aps-environment
	     need a provisioning profile, which only the store signing has. -->
	<!-- Mac App Store requires the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Supabase, Sentry, Noten-Downloads. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Datei öffnen/speichern über den Systemdialog (Noten, Exporte). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Exporte und PDFs direkt in „Downloads“. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Sibelius-Plugin von Attendix direkt in den Plug-ins-Ordner von Sibelius legen
	     (ohne Ordnerauswahl; ohne das Recht fragt die App nach dem Ordner). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Avid/Sibelius/Plugins/</string>
	</array>
	<!-- QR-Code-Einladungen scannen (mobile_scanner). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Drucken (printing). -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- flutter_secure_storage: Schlüsselbund der App. -->
	<!-- Push (APNs over Firebase): TestFlight and App Store. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.stephanus.attendix</string>
	</array>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
