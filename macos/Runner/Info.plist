<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MAC_SKIA: Flutter 3.47 draws the Mac app with Impeller by default. Up
	     to 3.47.9 Impeller on macOS can reuse a GPU staging buffer too early,
	     so single letters (or all text) turn into pixel noise until the app
	     restarts (flutter/flutter#193927, fixed by #188965 in 3.50). Skia has
	     no such fault. Remove this key once the project builds with Flutter
	     3.50 or newer. -->
	<key>FLTEnableImpeller</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Attendix nutzt das Mikrofon nur für die Spracheingabe im Chat-Assistenten, solange du das Mikrofon antippst.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Die Spracheingabe im Chat-Assistenten wandelt deine Worte in Text um, möglichst direkt auf dem Gerät.</string>
	<key>NSCameraUsageDescription</key>
	<string>Attendix nutzt die Kamera nur, um den QR-Code einer Einladung zu scannen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attendix greift auf deine Fotos zu, wenn du ein Bild auswählst, zum Beispiel ein Profilbild.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Attendix speichert Fotos nur, wenn du das selbst auslöst.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Attendix greift nur auf deine Mediathek zu, wenn du selbst eine Audiodatei auswählst.</string>
	<key>NSLocationUsageDescription</key>
	<string>Attendix fragt nicht nach deinem Standort. Die Angabe ist nur nötig, weil eine eingebundene Bibliothek die Standortfunktion enthält.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Attendix fragt nicht nach deinem Standort. Die Angabe ist nur nötig, weil eine eingebundene Bibliothek die Standortfunktion enthält.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
