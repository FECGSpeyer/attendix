<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Supabase, Sentry, Noten-Downloads. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Datei öffnen/speichern über den Systemdialog (Noten, Exporte). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Exporte und PDFs direkt in „Downloads“. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- QR-Code-Einladungen scannen (mobile_scanner). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Drucken (printing). -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- flutter_secure_storage: Schlüsselbund der App. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.stephanus.attendix</string>
	</array>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
